# Server-Only Database Configuration (Never expose to client components or NEXT_PUBLIC_*)
DATABASE_URL="file:./platform.db"

# Auth.js Configuration (Generate locally via: npx auth secret)
AUTH_SECRET="replace-with-cryptographically-random-32-byte-secret"
AUTH_TRUST_HOST=true

# Public Non-Sensitive Environment Metadata
NEXT_PUBLIC_APP_ENV=development
