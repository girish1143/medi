// ============================================================================
// Healthcare Lead Generation Platform — Relational Database Schema (SQLite)
// ORM: Prisma 6+ | Policy: Zero Dummy Data (Schema initializes empty)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// 1. Identity & Administrative RBAC (Models 1-4)
// ----------------------------------------------------------------------------

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  phone         String?   @unique
  fullName      String
  passwordHash  String?
  // Enum alternative: SUPER_ADMIN | OPERATIONS_ADMIN | FINANCE_ADMIN | SUPPORT_ADMIN | PATIENT | DOCTOR | HOSPITAL
  role          String    @default("PATIENT")
  // Enum alternative: PENDING_VERIFICATION | ACTIVE | SUSPENDED | DEACTIVATED
  accountStatus String    @default("PENDING_VERIFICATION")
  adminRoleId   String?
  emailVerified DateTime?
  mfaEnabled    Boolean   @default(false)
  lastLoginAt   DateTime?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  adminRole            AdminRole?       @relation(fields: [adminRoleId], references: [id], onDelete: SetNull)
  patient              Patient?
  doctor               Doctor?
  hospital             Hospital?
  verifiedDoctors      Doctor[]         @relation("DoctorVerifiedBy")
  verifiedHospitals    Hospital[]       @relation("HospitalVerifiedBy")
  qualifiedLeads       Lead[]           @relation("LeadQualifiedBy")
  assignedLeads        LeadAssignment[] @relation("LeadAssignedBy")
  leadHistoryEntries   LeadHistory[]
  notifications        Notification[]
  requestedTickets     SupportTicket[]  @relation("TicketRequester")
  assignedTickets      SupportTicket[]  @relation("TicketAssignedAdmin")
  auditLogs            AuditLog[]

  @@index([adminRoleId])
  @@index([role, accountStatus])
  @@index([deletedAt])
}

model AdminRole {
  id           String   @id @default(uuid())
  // Enum alternative: SUPER_ADMIN | OPERATIONS_ADMIN | FINANCE_ADMIN | SUPPORT_ADMIN
  code         String   @unique
  name         String
  description  String?
  isSystemRole Boolean  @default(true)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users       User[]
  permissions AdminRolePermission[]

  @@index([isActive])
}

model AdminPermission {
  id          String   @id @default(uuid())
  code        String   @unique
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles AdminRolePermission[]

  @@unique([resource, action])
}

model AdminRolePermission {
  id           String   @id @default(uuid())
  adminRoleId  String
  permissionId String
  grantedAt    DateTime @default(now())
  createdAt    DateTime @default(now())

  adminRole  AdminRole       @relation(fields: [adminRoleId], references: [id], onDelete: Cascade)
  permission AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([adminRoleId, permissionId])
  @@index([adminRoleId])
  @@index([permissionId])
}

// ----------------------------------------------------------------------------
// 2. Patients, Hospitals & Doctors (Models 5-9)
// ----------------------------------------------------------------------------

model Patient {
  id                    String    @id @default(uuid())
  userId                String    @unique
  dateOfBirth           DateTime?
  // Enum alternative: FEMALE | MALE | NON_BINARY | PREFER_NOT_TO_SAY | OTHER
  gender                String?
  preferredLanguage     String    @default("en")
  city                  String?
  stateProvince         String?
  postalCode            String?
  countryCode           String?
  emergencyContactName  String?
  emergencyContactPhone String?
  archivedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  leads    Lead[]
  consents PatientConsent[]

  @@index([countryCode, stateProvince, city])
  @@index([archivedAt])
}

model Hospital {
  id                     String    @id @default(uuid())
  userId                 String    @unique
  legalName              String
  displayName            String
  registrationNumber     String
  accreditationBody      String?
  accreditationNumber    String?
  // Enum alternative: PENDING | UNDER_REVIEW | VERIFIED | REJECTED | SUSPENDED
  verificationStatus     String    @default("PENDING")
  verifiedAt             DateTime?
  verifiedByUserId       String?
  rejectionReason        String?
  isAcceptingLeads       Boolean   @default(false)
  offersTeleconsultation Boolean   @default(false)
  addressLine1           String
  addressLine2           String?
  city                   String
  stateProvince          String
  postalCode             String
  countryCode            String
  contactEmail           String
  contactPhone           String
  websiteUrl             String?
  bedCapacity            Int?
  archivedAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user              User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  verifiedByUser    User?                @relation("HospitalVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  departments       HospitalDepartment[]
  affiliatedDoctors Doctor[]
  leadAssignments   LeadAssignment[]
  targetedConsents  PatientConsent[]
  subscriptions     Subscription[]
  invoices          Invoice[]
  payments          Payment[]

  @@unique([countryCode, registrationNumber])
  @@index([verifiedByUserId])
  @@index([verificationStatus, isAcceptingLeads, countryCode, stateProvince, city])
  @@index([archivedAt])
}

model HospitalDepartment {
  id                 String   @id @default(uuid())
  hospitalId         String
  name               String
  specializationCode String
  specializationName String
  headDoctorName     String?
  isActive           Boolean  @default(true)
  isAcceptingLeads   Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, specializationCode])
  @@index([hospitalId])
  @@index([specializationCode, isActive, isAcceptingLeads])
}

model Doctor {
  id                   String    @id @default(uuid())
  userId               String    @unique
  primaryHospitalId    String?
  medicalLicenseNumber String
  licensingAuthority   String
  licenseCountryCode   String
  licenseExpiresAt     DateTime?
  // Enum alternative: PENDING | UNDER_REVIEW | VERIFIED | REJECTED | SUSPENDED
  verificationStatus   String    @default("PENDING")
  verifiedAt           DateTime?
  verifiedByUserId     String?
  rejectionReason      String?
  qualificationSummary String?
  yearsOfExperience    Int       @default(0)
  // Enum alternative: IN_PERSON | TELECONSULTATION | BOTH
  consultationMode     String    @default("IN_PERSON")
  consultationFeeMinor Int?
  currency             String?
  isAcceptingLeads     Boolean   @default(false)
  city                 String
  stateProvince        String
  countryCode          String
  bio                  String?
  archivedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user             User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  primaryHospital  Hospital?              @relation(fields: [primaryHospitalId], references: [id], onDelete: SetNull)
  verifiedByUser   User?                  @relation("DoctorVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  specializations  DoctorSpecialization[]
  leadAssignments  LeadAssignment[]
  targetedConsents PatientConsent[]
  subscriptions    Subscription[]
  invoices         Invoice[]
  payments         Payment[]

  @@unique([licenseCountryCode, medicalLicenseNumber])
  @@index([primaryHospitalId])
  @@index([verifiedByUserId])
  @@index([verificationStatus, isAcceptingLeads, countryCode, stateProvince, city])
  @@index([archivedAt])
}

model DoctorSpecialization {
  id                 String   @id @default(uuid())
  doctorId           String
  specializationCode String
  specializationName String
  isPrimary          Boolean  @default(false)
  boardCertified     Boolean  @default(false)
  yearsExperience    Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, specializationCode])
  @@index([doctorId])
  @@index([specializationCode, doctorId])
}

// ----------------------------------------------------------------------------
// 3. Lead Generation, Assignments, History & Consent (Models 10-13)
// ----------------------------------------------------------------------------

model Lead {
  id                 String    @id @default(uuid())
  patientId          String
  specialization     String
  locationCity       String
  locationState      String
  countryCode        String
  // Enum alternative: IN_PERSON | TELECONSULTATION | BOTH
  consultationMode   String    @default("IN_PERSON")
  // High-level intake description only; avoid unnecessary sensitive clinical details
  enquiryDescription String
  // Enum alternative: WEB_PORTAL | MOBILE_APP | REFERRAL | PARTNER_API | SUPPORT_ASSISTED
  leadSource         String    @default("WEB_PORTAL")
  // Enum alternative: NEW | UNDER_REVIEW | QUALIFIED | ASSIGNED | CONTACTED | CONVERTED | REJECTED | CLOSED
  status             String    @default("NEW")
  // Enum alternative: LOW | MEDIUM | HIGH | URGENT
  priority           String    @default("MEDIUM")
  idempotencyKey     String
  qualifiedAt        DateTime?
  qualifiedByUserId  String?
  closedAt           DateTime?
  closureReason      String?
  archivedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  patient         Patient          @relation(fields: [patientId], references: [id], onDelete: Restrict)
  qualifiedByUser User?            @relation("LeadQualifiedBy", fields: [qualifiedByUserId], references: [id], onDelete: SetNull)
  assignments     LeadAssignment[]
  history         LeadHistory[]
  consents        PatientConsent[]
  supportTickets  SupportTicket[]

  @@unique([patientId, idempotencyKey])
  @@index([patientId, createdAt])
  @@index([qualifiedByUserId])
  @@index([status, priority, createdAt])
  @@index([specialization, countryCode, locationState, locationCity, status])
  @@index([archivedAt])
}

model LeadAssignment {
  id               String    @id @default(uuid())
  leadId           String
  // Enum alternative: DOCTOR | HOSPITAL
  providerType     String
  doctorId         String?
  hospitalId       String?
  // Enum alternative: PENDING | ACCEPTED | REJECTED | EXPIRED | REVOKED
  status           String    @default("PENDING")
  assignedByUserId String?
  matchScore       Float?
  assignedAt       DateTime  @default(now())
  expiresAt        DateTime?
  acceptedAt       DateTime?
  rejectedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  lead           Lead          @relation(fields: [leadId], references: [id], onDelete: Restrict)
  doctor         Doctor?       @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  hospital       Hospital?     @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  assignedByUser User?         @relation("LeadAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  history        LeadHistory[]

  @@index([leadId, status])
  @@index([leadId, doctorId, status])
  @@index([leadId, hospitalId, status])
  @@index([doctorId, status])
  @@index([hospitalId, status])
  @@index([assignedByUserId])
}

model LeadHistory {
  id           String   @id @default(uuid())
  leadId       String
  assignmentId String?
  actorUserId  String?
  eventType    String
  fromStatus   String?
  toStatus     String?
  reason       String?
  metadataJson String?
  createdAt    DateTime @default(now())

  lead       Lead            @relation(fields: [leadId], references: [id], onDelete: Restrict)
  assignment LeadAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  actorUser  User?           @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([assignmentId])
  @@index([actorUserId])
}

model PatientConsent {
  id                      String    @id @default(uuid())
  patientId               String
  leadId                  String
  // Enum alternative: PLATFORM_TRIAGE | PROVIDER_CONTACT_DISCLOSURE | TELEHEALTH_COMMUNICATION
  consentPurpose          String
  // Enum alternative: MATCHED_PROVIDERS | SPECIFIC_DOCTOR | SPECIFIC_HOSPITAL
  authorizedProviderScope String
  authorizedDoctorId      String?
  authorizedHospitalId    String?
  // Enum alternative: GRANTED | REVOKED | EXPIRED
  status                  String    @default("GRANTED")
  consentVersion          String
  grantedAt               DateTime  @default(now())
  expiresAt               DateTime?
  revokedAt               DateTime?
  revocationReason        String?
  ipHash                  String?
  userAgentHash           String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  patient            Patient   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  lead               Lead      @relation(fields: [leadId], references: [id], onDelete: Restrict)
  authorizedDoctor   Doctor?   @relation(fields: [authorizedDoctorId], references: [id], onDelete: Restrict)
  authorizedHospital Hospital? @relation(fields: [authorizedHospitalId], references: [id], onDelete: Restrict)

  @@index([patientId, leadId, status])
  @@index([leadId, status, consentPurpose])
  @@index([authorizedDoctorId])
  @@index([authorizedHospitalId])
}

// ----------------------------------------------------------------------------
// 4. Subscriptions, Invoices & Tokenized Payments (Models 14-17)
// Security: Never store payment card numbers, PAN, CVV, or card expiry dates.
// ----------------------------------------------------------------------------

model SubscriptionPlan {
  id                 String   @id @default(uuid())
  code               String   @unique
  name               String
  description        String?
  // Enum alternative: DOCTOR | HOSPITAL | BOTH
  targetProviderType String
  // Enum alternative: MONTHLY | QUARTERLY | ANNUAL
  billingCycle       String
  priceMinor         Int
  currency           String
  monthlyLeadQuota   Int
  featuresJson       String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  subscriptions Subscription[]

  @@index([isActive, targetProviderType])
}

model Subscription {
  id                     String    @id @default(uuid())
  planId                 String
  // Enum alternative: DOCTOR | HOSPITAL
  providerType           String
  doctorId               String?
  hospitalId             String?
  // Enum alternative: TRIALING | ACTIVE | PAST_DUE | CANCELLED | EXPIRED
  status                 String    @default("TRIALING")
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  leadsAllocatedInPeriod Int       @default(0)
  leadsConsumedInPeriod  Int       @default(0)
  cancelAtPeriodEnd      Boolean   @default(false)
  cancelledAt            DateTime?
  gatewayProvider        String?
  gatewaySubscriptionId  String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  plan     SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  doctor   Doctor?          @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  hospital Hospital?        @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  invoices Invoice[]
  payments Payment[]

  @@index([planId])
  @@index([doctorId, status])
  @@index([hospitalId, status])
  @@index([status, currentPeriodEnd])
}

model Invoice {
  id             String    @id @default(uuid())
  invoiceNumber  String    @unique
  subscriptionId String
  // Enum alternative: DOCTOR | HOSPITAL
  providerType   String
  doctorId       String?
  hospitalId     String?
  // Enum alternative: DRAFT | OPEN | PAID | VOID | UNCOLLECTIBLE
  status         String    @default("DRAFT")
  subtotalMinor  Int
  taxMinor       Int       @default(0)
  totalMinor     Int
  currency       String
  issuedAt       DateTime?
  dueAt          DateTime?
  paidAt         DateTime?
  periodStart    DateTime
  periodEnd      DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  doctor       Doctor?      @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  hospital     Hospital?    @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  payments     Payment[]

  @@index([subscriptionId])
  @@index([doctorId, status])
  @@index([hospitalId, status])
}

model Payment {
  id                String    @id @default(uuid())
  subscriptionId    String
  invoiceId         String?
  // Enum alternative: DOCTOR | HOSPITAL
  providerType      String
  doctorId          String?
  hospitalId        String?
  gatewayProvider   String
  gatewayPaymentId  String
  gatewayCustomerId String?
  // Enum alternative: CARD_TOKEN | UPI | ACH | WIRE | NETBANKING | OTHER
  paymentMethodType String
  amountMinor       Int
  refundedMinor     Int       @default(0)
  currency          String
  // Enum alternative: PENDING | REQUIRES_ACTION | SUCCEEDED | FAILED | REFUNDED | PARTIALLY_REFUNDED
  status            String    @default("PENDING")
  idempotencyKey    String    @unique
  failureCode       String?
  failureMessage    String?
  paidAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  doctor       Doctor?      @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  hospital     Hospital?    @relation(fields: [hospitalId], references: [id], onDelete: Restrict)

  @@unique([gatewayProvider, gatewayPaymentId])
  @@index([subscriptionId, status])
  @@index([invoiceId])
  @@index([doctorId])
  @@index([hospitalId])
}

// ----------------------------------------------------------------------------
// 5. Notifications, Support & Immutable Audit Logs (Models 18-20)
// ----------------------------------------------------------------------------

model Notification {
  id                String    @id @default(uuid())
  recipientUserId   String
  // Enum alternative: IN_APP | EMAIL | SMS | PUSH
  channel           String
  templateKey       String
  title             String
  body              String
  payloadJson       String?
  // Enum alternative: QUEUED | SENT | DELIVERED | FAILED | READ
  status            String    @default("QUEUED")
  relatedEntityType String?
  relatedEntityId   String?
  sentAt            DateTime?
  readAt            DateTime?
  failedReason      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  recipient User @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, readAt, createdAt])
  @@index([status, channel])
}

model SupportTicket {
  id                  String    @id @default(uuid())
  ticketNumber        String    @unique
  requesterUserId     String
  assignedAdminUserId String?
  leadId              String?
  category            String
  // Enum alternative: LOW | MEDIUM | HIGH | CRITICAL
  priority            String    @default("MEDIUM")
  // Enum alternative: OPEN | IN_PROGRESS | WAITING_ON_USER | RESOLVED | CLOSED
  status              String    @default("OPEN")
  subject             String
  description         String
  resolutionNotes     String?
  resolvedAt          DateTime?
  closedAt            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  requester     User  @relation("TicketRequester", fields: [requesterUserId], references: [id], onDelete: Restrict)
  assignedAdmin User? @relation("TicketAssignedAdmin", fields: [assignedAdminUserId], references: [id], onDelete: SetNull)
  lead          Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([requesterUserId, status])
  @@index([assignedAdminUserId, status])
  @@index([leadId])
  @@index([status, priority, createdAt])
}

model AuditLog {
  id            String   @id @default(uuid())
  actorUserId   String?
  actorRole     String?
  action        String
  resourceType  String
  resourceId    String?
  // Enum alternative: SUCCESS | DENIED | FAILURE
  outcome       String   @default("SUCCESS")
  requestId     String?
  ipHash        String?
  userAgentHash String?
  metadataJson  String?
  createdAt     DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@index([action, createdAt])
}
