# Server Configuration
NODE_ENV=development
PORT=4000

# CORS Allowlist (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Supabase Configuration (Backend Only)
# SECURITY WARNING: Never expose SUPABASE_SERVICE_ROLE_KEY to frontend/ or browsers.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Webhook Verification (Optional in Phase 1; required before billing webhook activation)
PAYMENT_WEBHOOK_SECRET=
