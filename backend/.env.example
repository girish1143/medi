# ---------------------------------------------------------------------------
# MediBook backend environment
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# Database (Supabase Postgres or any PostgreSQL 14+)
# Local development: embedded PostgreSQL is started automatically when
# DEV_EMBEDDED_PG=true. In production set this to false and use Supabase.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/medibook
DATABASE_SSL=false
DEV_EMBEDDED_PG=true
DEV_PG_PORT=55432
DEV_PG_DIR=.pgdata
SEED_ON_START=true
AUTO_MIGRATE=true

# Authentication
# local  -> email+password auth handled by this API (development only)
# supabase -> credentials and tokens verified through Supabase Auth
AUTH_PROVIDER=local
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false

# Supabase (required in production)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDICAL_BUCKET=medical-records
SUPABASE_AVATAR_BUCKET=avatars

# Storage: supabase (production) | local (development filesystem)
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=storage
SIGNED_URL_TTL_SECONDS=300

# Payments: razorpay (production) | dev (local simulated checkout)
PAYMENTS_MODE=dev
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR

# Booking policies (defaults, can be overridden via platform_settings)
BOOKING_MIN_NOTICE_MINUTES=60
BOOKING_MAX_ADVANCE_DAYS=60
CANCELLATION_MIN_HOURS=4
RESCHEDULE_MIN_HOURS=4
PAY_AT_CLINIC_ENABLED=true

# Notification providers: console | resend | msg91
EMAIL_PROVIDER=console
EMAIL_FROM=MediBook <no-reply@medibook.test>
EMAIL_API_KEY=
SMS_PROVIDER=console
SMS_API_KEY=
REMINDER_CRON_ENABLED=true

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=600
