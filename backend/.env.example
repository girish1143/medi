# Backend Server Environment Template (Never commit .env with real secrets)
NODE_ENV=development
PORT=4000

# SQLite Database via Prisma ORM
DATABASE_URL="file:./dev.db"

# Strict Allowed CORS Origin(s) - comma-separated
FRONTEND_ORIGIN=http://localhost:3000

# Asymmetric or high-entropy HMAC JWT secrets (minimum 32 characters; generate with crypto.randomBytes(48).toString('hex'))
JWT_ACCESS_SECRET=replace-with-random-64-char-hex-access-secret-minimum-32
JWT_REFRESH_SECRET=replace-with-random-64-char-hex-refresh-secret-minimum-32

# Token TTLs
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Optional AES-256-GCM Field Encryption Key (64 hex characters = 32 bytes)
FIELD_ENCRYPTION_KEY=

# Cookie Settings
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=localhost

# Logging Level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
